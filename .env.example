# ============================================================================
# LedgerForge environment template
# ============================================================================
# Copy this to ".env" (which is gitignored) and adjust if needed.
# The defaults match docker-compose.yml so they work out of the box.
#
#   cp .env.example .env
# ============================================================================

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://ledger:ledger_dev_pw@localhost:5432/ledgerforge

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---
API_PORT=3001

# --- Idempotency ---
# How long (seconds) an idempotency key is remembered in Redis. 24h.
IDEMPOTENCY_TTL_SECONDS=86400

# --- Webhooks / retries ---
# Base delay (ms) for exponential backoff between webhook retry attempts.
WEBHOOK_RETRY_BASE_MS=1000
# Max attempts before a webhook is marked 'dead'.
WEBHOOK_MAX_ATTEMPTS=6
